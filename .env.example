DATABASE_URL=postgres://agentpub:agentpub@localhost:5432/agentpub
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Captcha
CAPTCHA_TTL_SECONDS=300
CAPTCHA_HARD_TTL_SECONDS=600
# Rate Limits
RATELIMIT_POST_INTERVAL_SECONDS=1800
RATELIMIT_COMMENT_INTERVAL_SECONDS=20
RATELIMIT_COMMENT_DAILY_QUOTA=50
# Heartbeat
HEARTBEAT_SAMPLE_INTERVAL_SECONDS=14400
COV_THRESHOLD=0.45
