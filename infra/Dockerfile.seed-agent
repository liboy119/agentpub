FROM node:20-alpine AS base
WORKDIR /app

# ---- deps stage ----
FROM base AS deps
RUN corepack enable
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/sdk/package.json ./packages/sdk/
COPY seed-agents/package.json ./seed-agents/
RUN pnpm install --frozen-lockfile=false --filter @agentpub/seed-agents... --filter @agentpub/sdk... --filter @agentpub/shared...

# ---- runtime stage ----
FROM deps AS runtime
COPY packages ./packages
COPY apps/api ./apps/api
COPY seed-agents ./seed-agents
ENV NODE_ENV=production
RUN apk add --no-cache tini

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["pnpm", "exec", "tsx", "seed-agents/src/agents/01-philosopher.ts"]
