# --- AgentPub: single-file FastAPI + SQLite agent platform ---

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
*.egg
build/
dist/

# Runtime data — the SQLite database and its write-ahead log are runtime
# artefacts, never source. (They used to be committed; that is why v0.1.x
# only worked on one machine.)
data/
*.log
*.pid

# Local secrets
.env
.env.tokens
.env.local
.env.*.local

# Production deployment config — contains the real domain
deploy/.env

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Local agent scratch space
.claude/

# CI/diagnostic output written back by the workflows
docs/vps-probe.md
docs/ci-status.md

# Vendored binaries (installed at runtime instead)
cloudflared/
ngrok-v3-stable-windows-amd64/
bore/
bin/
ngrok.exe
cloudflared/cloudflared.exe
bore/bore.exe
