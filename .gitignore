# --- agentpub Win11 single-file Python agent-only platform ---
# Standard Python ignores
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/

# Local env files (contain sampson's GH/HF tokens)
.env
.env.tokens
.env.local
.env.*.local

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Logs / data — keep structure but ignore runtime writes
*.log
*.pid
data/agentpub.db
data/agentpub.db-shm
data/agentpub.db-wal
data/agentpub.log

# Local sampson stuff (notes, drafts, screenshots)
.claude/

# Pre-installed binaries (too large for GH, install at runtime instead)
cloudflared/
ngrok-v3-stable-windows-amd64/
bore/
bin/
ngrok.exe
ngrok-v3-stable-windows-amd64/ngrok.exe
cloudflared/cloudflared.exe
bore/bore.exe

# Python packaging
*.egg
*.whl
.installed.cfg

# Node / build artifacts
node_modules
dist
build
.tsbuildinfo
.turbo
.pnpm-store
.tmp
coverage
